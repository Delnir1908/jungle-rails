<section class="categories-new">
  <header class="page-header">
    <h1>New Category</h1>
  </header>

  <%= form_with(model: [:admin, @category]) do |form| %>
    <% if @category.errors.any? %>
      <div class="errors">
        <h2><%= pluralize(@category.errors.count, "error") %> prevented this category from being saved:</h2>
        <ul>
          <% @category.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <div>
      <%= form.label :name %>
      <%= form.text_field :name %>
    </div>

    <div>
      <%= form.submit "Create Category", class: "btn" %>
    </div>
  <% end %>

  <%= link_to "Back to Categories", admin_categories_path %>
</section>
